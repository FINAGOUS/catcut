<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DogSC" Width="1320" Height="880" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Workspace}" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <!-- W2 四区重排（2026-11-18）：主界面改成 素材库 / 监视 / 调节 / 预览轨道 四区 Grid。
      与 DogSC 原布局的区别：左侧新增 300px 素材库媒体池（原版没有）；竖轨从窗口最左移到调节区左缘；
      播放控制从时间线工具条移到监视区底部；时间线改为全宽轨道区，自带“预览轨道”区头与吸附/波纹指示。
      所有 x:Name 保持与 W1 一致，后台代码（EditorApp/EditorPolish/EditorEffectsUI 等）的 Find<> 接线不动。
      占位说明：素材库四分栏只做栏位与切换，内容由 W3 接入；“波纹”按钮仅视觉占位，交互由 W3 接线。 -->
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="EditorTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border CornerRadius="16" BorderBrush="{DynamicResource Line}" BorderThickness="0.7" Background="{DynamicResource Workspace}" ClipToBounds="True">
  <Grid x:Name="MainGrid">
   <Grid.RowDefinitions><RowDefinition x:Name="ToolbarRow" Height="66"/><RowDefinition Height="*"/><RowDefinition x:Name="TimelineRow" Height="272"/><RowDefinition Height="20"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource Panel}" x:Name="TitleBar"><Grid Margin="18,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ProjectMenu" Style="{StaticResource PlainButton}" ToolTip="项目"/><TextBlock x:Name="ProjectTitle" Text="未命名项目" FontWeight="SemiBold" Margin="12,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/><Button x:Name="Rename" Style="{StaticResource PlainButton}" ToolTip="重命名" Width="28"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="0.6" Padding="1"><StackPanel Orientation="Horizontal"><Button x:Name="Undo" Style="{StaticResource PlainButton}" Width="30" ToolTip="撤销 Ctrl+Z"/><Button x:Name="Redo" Style="{StaticResource PlainButton}" Width="30" ToolTip="重做 Ctrl+Y"/></StackPanel></Border><Button x:Name="Presets" Margin="10,0,0,0"/><Button x:Name="Export" Margin="9,0,0,0"/><Button x:Name="NewRecording" Margin="9,0,0,0" ToolTip="新建录制"/><Button x:Name="Theme" Style="{StaticResource PlainButton}" Margin="6,0,10,0" Width="32" ToolTip="切换明暗外观"/><Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="0,0,8,0"/><Button x:Name="Minimize" Style="{StaticResource PlainButton}" Width="27" ToolTip="最小化"/><Button x:Name="Maximize" Style="{StaticResource PlainButton}" Width="27" ToolTip="最大化 / 还原"/><Button x:Name="Close" Style="{StaticResource PlainButton}" Width="27" ToolTip="关闭"/></StackPanel>
   </Grid></Border>
   <!-- 四区工作区：左 素材库 / 中 监视 / 右 调节（竖轨 + 检查器） -->
   <Grid Grid.Row="1" x:Name="WorkspaceGrid" Margin="12,6,12,8"><Grid.ColumnDefinitions><ColumnDefinition x:Name="MediaLibraryColumn" Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="400"/></Grid.ColumnDefinitions>
    <!-- 一区：素材库（媒体池）。四分栏位 + 切换是 W2 的活；各栏内容由 W3 接入。 -->
    <Border x:Name="MediaLibrary" Style="{StaticResource SurfaceCard}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,0.7"><Grid Margin="14,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="素材库" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><Button x:Name="MediaLibraryImport" Grid.Column="1" Style="{StaticResource PlainButton}" Content="＋ 导入" ToolTip="打开视频或项目" Padding="8,5" MinHeight="28"/></Grid></Border>
     <Border Grid.Row="1" Background="{DynamicResource Well}" CornerRadius="11" Margin="10,5,10,3" Padding="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="MediaTabMedia" Content="素材" Style="{StaticResource PlainButton}" MinHeight="28" Padding="4,2"/>
      <Button x:Name="MediaTabMusic" Grid.Column="1" Content="音乐" Style="{StaticResource PlainButton}" MinHeight="28" Padding="4,2"/>
      <Button x:Name="MediaTabSubtitles" Grid.Column="2" Content="字幕" Style="{StaticResource PlainButton}" MinHeight="28" Padding="4,2"/>
      <Button x:Name="MediaTabEffects" Grid.Column="3" Content="特效" Style="{StaticResource PlainButton}" MinHeight="28" Padding="4,2"/>
     </Grid></Border>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="MediaLibraryContent" Margin="16,18,16,16"><TextBlock x:Name="MediaLibraryEmpty" Text="还没有素材" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="MediaLibraryHint" Text="导入视频后，素材会出现在这里。&#x0a;媒体池内容由 W3 接入。" Foreground="{DynamicResource Secondary}" FontSize="11" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    </Grid></Border>
    <!-- 二区：监视页面（主监视器，接 W1 的 GPU 预览面；只挪位置，不动 GpuPreview.cs 的渲染逻辑）。 -->
    <Grid x:Name="CanvasWorkspace" Grid.Column="1" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
     <Border Style="{StaticResource SurfaceCard}" CornerRadius="12"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="监视" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/><TextBlock Text="主监视器" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Ratio" Style="{StaticResource PlainButton}"/><Button x:Name="FitCanvas" Style="{StaticResource PlainButton}" ToolTip="居中并恢复画面大小"/><Button x:Name="AddZoom" Style="{StaticResource PlainButton}" Width="31" ToolTip="在播放头添加手动缩放"/><Button x:Name="CanvasOptions" Style="{StaticResource PlainButton}" Width="31" ToolTip="画面布局"/></StackPanel></Grid></Border>
     <Grid Grid.Row="1" x:Name="Stage" Margin="0,8,0,8" ClipToBounds="True"><Border x:Name="PreviewSurface" Background="{DynamicResource Surface}" Opacity="0.45" CornerRadius="16"/><Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="DogSC" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="录制、剪辑、运镜，到导出成片。" Foreground="{DynamicResource Secondary}" Margin="0,12,0,24" HorizontalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="EmptyRecord" Content="开始录制" Style="{StaticResource AccentButton}" Padding="20,12"/><Button x:Name="EmptyImport" Content="打开视频或项目" Padding="20,12" Margin="10,0,0,0"/></StackPanel></StackPanel>
     </Grid>
     <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" CornerRadius="12"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Previous" Width="35" Padding="8,5" ToolTip="回到开始"/><Button x:Name="Play" Width="38" Padding="9,5" Margin="6,0" ToolTip="播放 / 暂停（空格）"/><Button x:Name="Next" Width="35" Padding="8,5" ToolTip="跳到结尾"/><TextBlock x:Name="Timecode" Text="00:00.00  /  00:00.00" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="11"/></StackPanel></Grid></Border>
    </Grid>
    <!-- 三区：调节页面（竖轨 + 检查器）。竖轨仍是检查器页签切换（画面/开场/运镜/…），只是从窗口最左移到了调节区左缘。 -->
    <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="Rail" Style="{StaticResource SurfaceCard}" Margin="0,0,8,0" Padding="6,8"><ScrollViewer x:Name="RailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RailItems"/></ScrollViewer></Border>
     <Border x:Name="InspectorSurface" Grid.Column="1" Style="{StaticResource SurfaceCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,0.7"><StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center"><TextBlock Text="调节" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="InspectorTitle" Text="画面" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16"/><Border x:Name="InspectorScope" Visibility="Collapsed" Background="{DynamicResource Well}" CornerRadius="12" Padding="7,4" Margin="8,0,0,0"><TextBlock x:Name="InspectorScopeTitle" Foreground="{DynamicResource Secondary}" FontSize="11" VerticalAlignment="Center"/></Border></StackPanel></Border>
      <Border x:Name="InspectorNavigation" Grid.Row="1" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,0.7"><StackPanel x:Name="InspectorNavigationItems" Margin="12,8"/></Border>
      <ScrollViewer x:Name="InspectorScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Inspector" Margin="20,16,20,20"/></ScrollViewer>
     </Grid></Border>
    </Grid>
   </Grid>
   <!-- 四区：预览轨道（底部时间线，全宽）。多轨呈现由 DrawTimeline/AddEffectTracks 代码绘制（屏幕录制/缩放/贴图/柔化轨）；
        吸附（Snap）是现有开关；“波纹”按钮仅视觉占位，波纹编辑交互由 W3 接线。 -->
   <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Margin="12,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,0.7"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="预览轨道" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="Split" Style="{StaticResource PlainButton}" Width="30" ToolTip="在播放头分割 Ctrl+B"/><Button x:Name="Delete" Style="{StaticResource PlainButton}" Width="30" ToolTip="删除选中片段 Delete"/><Button x:Name="MoveLeft" Style="{StaticResource PlainButton}" Width="27" ToolTip="片段向左移动"/><Button x:Name="MoveRight" Style="{StaticResource PlainButton}" Width="27" ToolTip="片段向右移动"/><Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="7,0,10,0"/><Border Background="{DynamicResource Well}" CornerRadius="9" Padding="2"><StackPanel Orientation="Horizontal"><Button x:Name="TimelineView" Padding="9,3" MinHeight="27" BorderBrush="Transparent"/><Button x:Name="Waveforms" Content="波形" Style="{StaticResource PlainButton}" Padding="8,3" MinHeight="27" IsEnabled="False" ToolTip="音频波形尚未移植"/></StackPanel></Border></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Snap" Padding="8,4" MinHeight="28" BorderBrush="Transparent"/><Button x:Name="RipplePlaceholder" Content="波纹" Padding="8,4" MinHeight="28" BorderBrush="Transparent" IsEnabled="False" ToolTip="波纹编辑：W3 接线，本批仅视觉占位" Margin="6,0,0,0"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ZoomOut" Content="−" Style="{StaticResource PlainButton}" Width="25" ToolTip="缩小时间线"/><Slider x:Name="TimelineScale" Minimum="1" Maximum="8" Value="1" Width="68" Margin="0"/><Button x:Name="ZoomIn" Content="＋" Style="{StaticResource PlainButton}" Width="25" ToolTip="放大时间线"/></StackPanel>
    </Grid></Border>
    <ScrollViewer x:Name="TrackScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel x:Name="TimelineLabels" Margin="12,0,0,0"/><ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><Canvas x:Name="TimelineHost" Height="236" MinWidth="600" Background="Transparent"/></ScrollViewer></Grid></ScrollViewer>
   </Grid></Border>
   <TextBlock x:Name="Status" Grid.Row="3" Text="就绪" Margin="18,3,18,0" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
  </Grid>
 </Border>
</Window>
